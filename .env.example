# Cloudinary credentials, used only by scripts/migrate-images.mjs locally.
# Copy to .env and fill in. The app itself needs none of these.
#
# Rotate the secret if it was ever pasted into a chat, log, or commit.
# npx wrangler secret put CLOUDINARY_API_SECRET   # if you do need it on CF
#
# Do not add these to Vercel: this project deploys to Cloudflare Workers
# via Nitro, and the migrated image URLs are public delivery URLs.

CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
